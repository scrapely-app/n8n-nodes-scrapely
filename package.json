{
  "name": "n8n-nodes-scrapely",
  "version": "0.1.1",
  "description": "n8n nodes for Scrape.ly: run Actors and tasks, read results, and trigger workflows when runs finish.",
  "license": "MIT",
  "homepage": "https://scrape.ly",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "scrapely",
    "web-scraping",
    "scraper"
  ],
  "author": {
    "name": "Scrape.ly",
    "email": "support@scrape.ly"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scrapely-app/n8n-nodes-scrapely.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ScrapelyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Scrapely/Scrapely.node.js",
      "dist/nodes/ScrapelyTrigger/ScrapelyTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.52.6",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/scrapely-app/n8n-nodes-scrapely/issues"
  }
}
